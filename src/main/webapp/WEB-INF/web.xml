<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0"
         metadata-complete="false">

    <display-name>BookTrail</display-name>

    <!-- Global Authentication & UTF-8 Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.booktrail.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Discover Servlet -->
    <servlet>
        <servlet-name>DiscoverServlet</servlet-name>
        <servlet-class>com.booktrail.servlet.DiscoverServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DiscoverServlet</servlet-name>
        <url-pattern>/discover</url-pattern>
        <url-pattern>/books</url-pattern>
    </servlet-mapping>

    <!-- Book Detail Servlet -->
    <servlet>
        <servlet-name>BookServlet</servlet-name>
        <servlet-class>com.booktrail.servlet.BookServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookServlet</servlet-name>
        <url-pattern>/book</url-pattern>
    </servlet-mapping>

    <!-- Authentication Servlet -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.booktrail.servlet.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/register</url-pattern>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Bookshelf Servlet -->
    <servlet>
        <servlet-name>ShelfServlet</servlet-name>
        <servlet-class>com.booktrail.servlet.ShelfServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ShelfServlet</servlet-name>
        <url-pattern>/shelf</url-pattern>
        <url-pattern>/shelf/add</url-pattern>
        <url-pattern>/shelf/update</url-pattern>
        <url-pattern>/shelf/remove</url-pattern>
    </servlet-mapping>

    <!-- Community Rooms Servlet -->
    <servlet>
        <servlet-name>CommunityServlet</servlet-name>
        <servlet-class>com.booktrail.servlet.CommunityServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CommunityServlet</servlet-name>
        <url-pattern>/community</url-pattern>
    </servlet-mapping>

    <!-- Discussion Room & Spoiler Gate Servlet -->
    <servlet>
        <servlet-name>RoomServlet</servlet-name>
        <servlet-class>com.booktrail.servlet.RoomServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RoomServlet</servlet-name>
        <url-pattern>/room</url-pattern>
        <url-pattern>/post/create</url-pattern>
        <url-pattern>/comment/create</url-pattern>
        <url-pattern>/post/delete</url-pattern>
        <url-pattern>/comment/delete</url-pattern>
    </servlet-mapping>

    <!-- Profile & Reviews Servlet -->
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.booktrail.servlet.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
        <url-pattern>/review/save</url-pattern>
        <url-pattern>/review/delete</url-pattern>
        <url-pattern>/profile/bio</url-pattern>
    </servlet-mapping>

    <!-- Admin Console Servlet -->
    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.booktrail.servlet.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
        <url-pattern>/admin/book/add</url-pattern>
        <url-pattern>/admin/book/delete</url-pattern>
        <url-pattern>/admin/room/add</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
